+import { PetService, type PetAccountScope } from '../src/service.ts'
+import { makePetRoutes } from '../src/routes.ts'
+
+const alice: PetAccountScope = { source: 'dsh-passwords', id: 'immutable-a' }
+const bob: PetAccountScope = { source: 'dsh-passwords', id: 'immutable-b' }
+let root: string
+
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), 'dsh-pet-account-compat-'))
+  const asset = join(root, 'assets', 'whale')
+  mkdirSync(asset, { recursive: true })
+  writeFileSync(join(asset, 'pet.json'), JSON.stringify({
+    id: 'whale-girl', displayName: 'Whale', spritesheetPath: 'spritesheet.webp',
+  }))
+  writeFileSync(join(asset, 'spritesheet.webp'), 'webp')
+})
+
+afterEach(() => { rmSync(root, { recursive: true, force: true }) })
+
+function fixture(adapter?: { authenticate(request: Request): PetAccountScope | undefined }) {
+  const events = new Map<string, Set<(...args: unknown[]) => void>>()
+  const context = {
+    reflect: { provide: () => {} },
+    get: (name: string) => name === 'requestPrincipal' ? adapter : undefined,
+    on: (name: string, callback: (...args: unknown[]) => void) => {
+      let set = events.get(name)
+      if (!set) { set = new Set(); events.set(name, set) }
+      set.add(callback)
+      return () => { set.delete(callback) }
+    },
+  } as unknown as Context
+  const registry = loadPetRegistry({ packageRoot: root, petsDir: '', dshPetsDir: '' })
+  const service = new PetService(context, { persistDir: join(root, 'home'), registry })
+  return { service, context, events }
+}
+
+function accountFile(scope: PetAccountScope): string {
+  const digest = createHash('sha256').update(`${scope.source}\0${scope.id}`).digest('hex')
+  return join(root, 'home', 'pet-accounts', digest, 'pet.json')
+}
+
+async function request(
+  state: ReturnType<typeof fixture>,
+  path: string,
+  headers: Record<string, string> = {},
+  body?: unknown,
+): Promise<{ status: number; body: any }> {
+  const route = makePetRoutes({ service: state.service, ctx: state.context })
+    .find(entry => entry.path === path)!
+  const req = Readable.from(body === undefined ? [] : [Buffer.from(JSON.stringify(body))]) as IncomingMessage
+  Object.assign(req, {
+    method: body === undefined ? 'GET' : 'POST',
+    url: path,
+    headers: { host: 'localhost', ...headers },
+    socket: { remoteAddress: '127.0.0.1' },
+  })
+  return new Promise((resolve, reject) => {
+    let status = 200
+    const res = {
+      writeHead(code: number) { status = code; return this },
+      end(value: string | Buffer) { resolve({ status, body: JSON.parse(String(value)) }) },
+    } as unknown as ServerResponse
+    Promise.resolve(route.handler(req, res)).catch(reject)
+  })
+}
