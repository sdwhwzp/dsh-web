+    await expect(scope.set('enabled', false)).resolves.toBe(true)
+
+    // Then the accepted account snapshot is published with the new revision
+    expect(scope.getSnapshot()).toMatchObject({ revision: 3, value: { enabled: false } })
+    scope.dispose()
+  })
