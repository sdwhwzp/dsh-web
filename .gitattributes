# 统一换行符为 LF：文本文件在仓库与工作区均使用 LF，
# 优先级高于 core.autocrlf，Windows 检出时不再转 CRLF。
* text=auto eol=lf

# market/dist 是构建产物，字节必须与钉版内容一致：换行规范化会让干净检出
# 与重新生成的产物对不上（market:check 因此判 stale，deploy-market 车道失败）。
market/dist/** -text

# 二进制文件（git 自动检测之外的显式声明，防止被 text=auto 误判）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.node binary
*.wasm binary
*.bin binary

# 脚本与可执行文件强制 LF（确保跨平台与 CI / Linux / macOS / WSL 兼容执行，防止 bad interpreter）
*.sh text eol=lf
scripts/* text eol=lf

# Windows 批处理脚本（如未来新增）保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Byte-preserved satellite content, pinned by market-inputs.lock.json.
# EOF blank lines belong to the source assets; market:check verifies every byte.
market/dist/assets/skins/cafe-roastery/skin.css whitespace=-blank-at-eof
market/dist/assets/skins/observatory/patches.css whitespace=-blank-at-eof
market/dist/assets/skins/pixel-anime/patches.css whitespace=-blank-at-eof
market/dist/assets/skins/last-exile/hooks.mjs whitespace=-blank-at-eol
market/dist/assets/skins/porco-rosso/hooks.mjs whitespace=-blank-at-eol
market/dist/assets/skins/white-snake/hooks.mjs whitespace=-blank-at-eol
market/dist/assets/skins/crt-phosphor/assets/licenses/cubic-11-OFL.txt whitespace=-blank-at-eol
market/dist/assets/skins/meridian/skin.css whitespace=-blank-at-eol
market/dist/tryon-assets/skins/meridian/skin.css whitespace=-blank-at-eol

# Unified patches encode an empty context line as one space.
private-satellite-patches/*.patch whitespace=-blank-at-eol
# dsh-win-bash 随包 bash 载荷：二进制不得被 text=auto 或换行转换改写，
# MSYS 运行时的文本配置保持 LF，使 checksums.sha256 覆盖的字节在检出后不变。
packages/dsh-win-bash/runtime/win32-x64/usr/bin/* binary
packages/dsh-win-bash/runtime/win32-x64/licenses/* text eol=lf
packages/dsh-win-bash/runtime/win32-x64/etc/** text eol=lf
packages/dsh-win-bash/runtime/win32-x64/checksums.sha256 text eol=lf

# Preserve pinned satellite output and checksum-verified Windows payload bytes.
market/dist/assets/pets/deep-chan/pet.json whitespace=cr-at-eol
market/dist/tryon/assets/index-8zCIWMZH.js whitespace=-blank-at-eol
market/dist/tryon/assets/index-CzM9LeSx.js whitespace=-blank-at-eol
market/dist/tryon/assets/index-FenqlmyD.js whitespace=-blank-at-eol
packages/dsh-win-bash/runtime/win32-x64/etc/bash.bashrc whitespace=-blank-at-eol
packages/dsh-win-bash/runtime/win32-x64/etc/profile whitespace=-blank-at-eol
packages/dsh-win-bash/runtime/win32-x64/etc/profile.d/lang.sh whitespace=-blank-at-eol
packages/dsh-win-bash/runtime/win32-x64/licenses/gcc-libs-RUNTIME.LIBRARY.EXCEPTION.txt whitespace=-blank-at-eof
packages/dsh-win-bash/runtime/win32-x64/licenses/heimdal-LICENSE.txt whitespace=-blank-at-eol

